{
	"instructions":
	{
		"cargo":
		{
			"cmd":["cargo","build","--target","x86_64-unknown-uefi","--package","loadefi","--package","nvcore","--package","uefirtdrv"],
			"progressive":true
		},
		"svm_hv":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\svm_hv.asm"},
			"cancel_if_intact":[".\\src\\xpf_core\\msvc\\svm_hv.asm"]
		},
		"vt_hv":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\vt_hv.asm"},
			"cancel_if_intact":[".\\src\\xpf_core\\msvc\\vt_hv.asm"]
		},
		"interrupt":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\interrupt.asm"},
			"cancel_if_intact":[".\\src\\xpf_core\\msvc\\interrupt.asm"]
		},
		"msvcrt":
		{
			"cmd":["python","build_msvcrt.py","--outdir","{outdir}"],
			"cancel_if_intact":[".\\build-msvcrt.json",".\\build_msvcrt.py"]
		},
		"config":
		{
			"cmd":["python",".\\build\\makeueficonfig.py",".\\build\\DefaultUefiConfig.json",".\\bin\\{outdir}\\NoirVisorConfig.bin"]
		},
		"NoirVisor":
		{
			"cmd":["link","{objpath}\\svm_hv.obj","{objpath}\\vt_hv.obj","{objpath}\\interrupt.obj",".\\target\\x86_64-unknown-uefi\\{cargo_preset}\\libnvcore.a",".\\target\\x86_64-unknown-uefi\\{cargo_preset}\\libuefirtdrv.a",".\\bin\\{outdir}\\msvcrt-static.lib","/OUT:.\\bin\\{outdir}\\NoirVisor.efi","/SUBSYSTEM:EFI_RUNTIME_DRIVER","/ENTRY:NoirDriverEntry","/PDB:.\\bin\\{outdir}\\NoirVisor.pdb"],
			"dependencies":["cargo","svm_hv","vt_hv","interrupt","msvcrt"]
		},
		"image":
		{
			"cmd":["python","mkimg.py","-md","::/EFI","-md","::/EFI/BOOT","-c",".\\target\\x86_64-unknown-uefi\\{cargo_preset}\\loadefi.efi|::/EFI/BOOT/bootx64.efi","-c","bin\\{outdir}\\NoirVisor.efi|::/","-c","bin\\{outdir}\\NoirVisorConfig.bin|::/","-o",".\\bin\\{outdir}\\NoirVisor-Uefi.img"],
			"dependencies":["NoirVisor","config"]
		}
	},
	"common_flags":
	{
		"ml64":["/W3","/WX","/Zf","/Zd","/Zi","/I.\\src\\xpf_core\\msvc","/D_amd64","/D_msvc","/D_efi","/Fo{objpath}\\{instruction}.obj","/c","/nologo","{src}"],
		"link":["/NODEFAULTLIB","/NOLOGO","/DEBUG","/Machine:X64","/ERRORREPORT:QUEUE"]
	},
	"opt_flags":
	{
		"link":["/OPT:REF","/OPT:ICF"],
		"cargo":["--release"]
	},
	"extra_env":
	{
		"ar":"python {cd}\\build\\ar-lib.py",
		"cc":"cl",
		"cflags":"/GS-"
	},
	"internal_var":
	{
		"outdir_dev":"compchk_uefix64",
		"outdir_rel":"compfre_uefix64"
	}
}