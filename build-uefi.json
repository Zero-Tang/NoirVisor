{
	"instructions":
	{
		"cargo":
		{
			"cmd":["cargo","build","--target","x86_64-unknown-uefi","--package","loadefi","--package","nvcore"],
			"progressive":true
		},
		"driver":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\booting\\uefirtdrv\\driver.c"}
		},
		"cfgmgr":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\uefi\\cfgmgr.c"}
		},
		"host":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\uefi\\host.c"}
		},
		"uefihvm":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\uefi\\uefihvm.c"}
		},
		"svm_hv":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\svm_hv.asm"}
		},
		"vt_hv":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\vt_hv.asm"}
		},
		"interrupt":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\interrupt.asm"}
		},
		"kpcr":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\kpcr.asm"}
		},
		"msvcrt":
		{
			"cmd":["python","build_msvcrt.py","--outdir","{outdir}"]
		},
		"config":
		{
			"cmd":["python",".\\build\\makeueficonfig.py",".\\build\\DefaultUefiConfig.json",".\\bin\\{outdir}\\NoirVisorConfig.bin"]
		},
		"NoirVisor":
		{
			"cmd":["link","{objpath}\\driver.obj","{objpath}\\cfgmgr.obj","{objpath}\\host.obj","{objpath}\\uefihvm.obj","{objpath}\\svm_hv.obj","{objpath}\\vt_hv.obj","{objpath}\\interrupt.obj","{objpath}\\kpcr.obj",".\\target\\x86_64-unknown-uefi\\{cargo_preset}\\libnvcore.a",".\\bin\\{outdir}\\msvcrt-static.lib","/OUT:.\\bin\\{outdir}\\NoirVisor.efi","/SUBSYSTEM:EFI_RUNTIME_DRIVER","/ENTRY:NoirDriverEntry","/PDB:.\\bin\\{outdir}\\NoirVisor.pdb"],
			"dependencies":["driver","cfgmgr","host","uefihvm","cargo","svm_hv","vt_hv","interrupt","kpcr","msvcrt"]
		},
		"image":
		{
			"cmd":["python","mkimg.py","-md","::/EFI","-md","::/EFI/BOOT","-c",".\\target\\x86_64-unknown-uefi\\{cargo_preset}\\loadefi.efi|::/EFI/BOOT/bootx64.efi","-c","bin\\{outdir}\\NoirVisor.efi|::/","-c","bin\\{outdir}\\NoirVisorConfig.bin|::/","-o",".\\bin\\{outdir}\\NoirVisor-Uefi.img"],
			"dependencies":["NoirVisor","config"]
		}
	},
	"common_flags":
	{
		"cl":["{src}","/nologo","/I{EDK2_PATH}\\edk2\\MdePkg\\Include","/I{EDK2_PATH}\\edk2\\MdePkg\\Include\\X64","/I{ddkpath}\\include","/Zi","/W3","/WX","/FAcs","/Fa{objpath}\\{instruction}.cod","/Fo{objpath}\\{instruction}.obj","/Fd{objpath}","/FS","/GS-","/Qspectre","/Gr","/Gy","/TC","/c","/errorReport:queue"],
		"ml64":["/W3","/WX","/Zf","/Zd","/Zi","/I.\\src\\xpf_core\\msvc","/D_amd64","/D_msvc","/D_efi","/Fo{objpath}\\{instruction}.obj","/c","/nologo","{src}"],
		"link":["/NODEFAULTLIB","/LIBPATH:{EDK2_PATH}\\bin\\MdePkg\\{outdir}","MdePkgGuids.lib","BaseLib.lib","BaseDebugPrintErrorLevelLib.lib","BaseMemoryLib.lib","BasePrintLib.lib","UefiLib.lib","UefiDebugLibConOut.lib","UefiMemoryAllocationLib.lib","UefiDevicePathLibDevicePathProtocol.Lib","UefiBootServicesTableLib.Lib","UefiRuntimeServicesTableLib.Lib","/NOLOGO","/DEBUG","/Machine:X64","/ERRORREPORT:QUEUE"]
	},
	"opt_flags":
	{
		"cl":["/O2","/Gy"],
		"link":["/OPT:REF","/OPT:ICF"],
		"cargo":["--release"]
	},
	"extra_env":
	{
		"ar":"python {cd}\\build\\ar-lib.py",
		"cc":"cl",
		"cflags":"/GS-"
	},
	"internal_var":
	{
		"outdir_dev":"compchk_uefix64",
		"outdir_rel":"compfre_uefix64"
	}
}