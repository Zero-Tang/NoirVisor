{
	"instructions":
	{
		"cargo":
		{
			"cmd":["cargo","build","--target","x86_64-unknown-uefi","--package","loadefi","--package","nvcore","--package","uefirtdrv"],
			"progressive":true
		},
		"memcpy":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/memcpy.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/memcpy.asm"]
		},
		"memset":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/memset.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/memset.asm"]
		},
		"memcmp":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/memcmp.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/memcmp.asm"]
		},
		"strlen":
		{
			"cmd":["nasm","./src/xpf_core/crt/x64/strlen.asm"],
			"cancel_if_intact":["./src/xpf_core/crt/x64/strlen.asm"]
		},
		"config":
		{
			"cmd":["{python}","./build/makeueficonfig.py","./build/DefaultUefiConfig.json","./bin/{outdir}/NoirVisorConfig.bin"]
		},
		"NoirVisor":
		{
			"cmd":["lld-link","./target/x86_64-unknown-uefi/{cargo_preset}/libnvcore.a","{objpath}/memcpy.obj","{objpath}/memset.obj","{objpath}/memcmp.obj","{objpath}/strlen.obj","/OUT:./bin/{outdir}/NoirVisor.efi","/SUBSYSTEM:EFI_RUNTIME_DRIVER","/ENTRY:NoirDriverEntry","/PDB:./bin/{outdir}/NoirVisor.pdb"],
			"dependencies":["cargo","memcpy","memset","memcmp","strlen"]
		},
		"image":
		{
			"cmd":["{python}","mkimg.py","-md","::/EFI","-md","::/EFI/BOOT","-c","./target/x86_64-unknown-uefi/{cargo_preset}/loadefi.efi|::/EFI/BOOT/bootx64.efi","-c","bin/{outdir}/NoirVisor.efi|::/","-c","bin/{outdir}/NoirVisorConfig.bin|::/","-o","./bin/{outdir}/NoirVisor-Uefi.img"],
			"dependencies":["NoirVisor","config"]
		},
		"vhdx":
		{
			"cmd":["qemu-img","convert","-f","raw","-O","vhdx","./bin/{outdir}/NoirVisor-Uefi.img","./bin/{outdir}/NoirVisor-Uefi.vhdx"],
			"dependencies":["image"]
		},
		"vmdk":
		{
			"cmd":["qemu-img","convert","-f","raw","-O","vmdk","./bin/{outdir}/NoirVisor-Uefi.img","./bin/{outdir}/NoirVisor-Uefi.vmdk"],
			"dependencies":["image"]
		}
	},
	"common_flags":
	{
		"nasm":["-fwin64","-D_VCRUNTIME_BUILD_QSPECTRE","-g","-o","{objpath}/{instruction}.obj","-l","{objpath}/{instruction}.lst","-Ox"],
		"lld-link":["/NODEFAULTLIB","/NOLOGO","/DEBUG","/OPT:REF","/Machine:X64","/ERRORREPORT:QUEUE"]
	},
	"opt_flags":
	{
		"lld-link":["/OPT:ICF"],
		"cargo":["--release"]
	},
	"extra_env":
	{
		"AR_x86_64-unknown-uefi":"llvm-ar",
		"CC_x86_64-unknown-uefi":"clang-cl",
		"CFLAGS_x86_64-unknown-uefi":"/GS- --target=x86_64-pc-windows-msvc -mno-sse -gcodeview"
	},
	"internal_var":
	{
		"outdir_dev":"compchk_uefix64",
		"outdir_rel":"compfre_uefix64"
	}
}