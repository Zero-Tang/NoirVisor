		{
			"cmd":["link","{objpath}\\driver.obj","{objpath}\\version.res","{objpath}\\detour.obj","{objpath}\\hooks.obj","{objpath}\\layered.obj","{objpath}\\nvsys.obj","{objpath}\\winhvm.obj","{objpath}\\msrhook.obj","{objpath}\\hvcall.obj","{objpath}\\memcpy.obj","{objpath}\\memset.obj","{objpath}\\memcmp.obj","{objpath}\\strlen.obj",".\\target\\x86_64-pc-windows-msvc\\{cargo_preset}\\nvcore.lib","/OUT:.\\bin\\{outdir}\\NoirVisor.sys","/SUBSYSTEM:NATIVE","/ENTRY:NoirDriverEntry","/PDB:.\\bin\\{outdir}\\NoirVisor.pdb","/INTEGRITYCHECK"],
