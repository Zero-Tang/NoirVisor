{
	"instructions":
	{
		"cargo":
		{
			"cmd":["cargo","build","--target","x86_64-pc-windows-msvc","--package","cvsched"],
			"progressive":true
		},
		"version":
		{
			"cmd":["llvm-rc","/FO{objpath}/version.res","/N","./crates/windrv/version.rc"],
			"cancel_if_intact":["./crates/windrv/version.rc"]
		},
		"import":
		{
			"cmd":["llvm-lib","/def:./crates/windrv/import.def","/machine:X64","/out:./bin/{outdir}/ntoskrnl.lib"],
			"cancel_if_intact":["./crates/windrv/import.def"]
		},
		"NoirVisor":
		{
			"cmd":["lld-link","./target/x86_64-pc-windows-msvc/{cargo_preset}/cvsched.lib","{objpath}/version.res","./bin/{outdir}/ntoskrnl.lib","/OUT:./bin/{outdir}/NoirVisor-unsigned.sys","/SUBSYSTEM:NATIVE","/ENTRY:NoirDriverEntry","/PDB:./bin/{outdir}/NoirVisor.pdb"],
			"dependencies":["cargo","version","import"]
		},
		"pre-sign":
		{
			"cmd":["{python}","rm.py","./bin/{outdir}/NoirVisor.sys"]
		},
		"sign":
		{
			"cmd":["osslsigncode","sign","-h","sha1","-pkcs12","./build/ztnxtest.pfx","-in","./bin/{outdir}/NoirVisor-unsigned.sys","-out","./bin/{outdir}/NoirVisor.sys"],
			"dependencies":["NoirVisor","pre-sign"],
			"cancel_if_opt":true
		}
	},
	"common_flags":
	{
		"lld-link":["/NODEFAULTLIB","/NOLOGO","/DEBUG","/INTEGRITYCHECK","/DRIVER","/TSAWARE:NO","/OPT:REF","/OPT:ICF","/Machine:X64","/ERRORREPORT:QUEUE"]
	},
	"opt_flags":
	{
		"cl":["/O2","/Gy"],
		"link":["/OPT:REF","/OPT:ICF"],
		"cargo":["--release"]
	},
	"extra_env":
	{
		"cflags":"/GS-"
	},
	"internal_var":
	{
		"outdir_dev":"compchk_win7x64",
		"outdir_rel":"compfre_win7x64"
	}
}