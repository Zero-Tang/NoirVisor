{
	"instructions":
	{
		"cargo":
		{
			"cmd":["cargo","build","--target","x86_64-pc-windows-msvc"],
			"progressive":true
		},
		"driver":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\booting\\windrv\\driver.c"}
		},
		"version":
		{
			"cmd":["rc","/nologo","/i{incpath}\\shared","/i{incpath}\\um","/i{incpath}\\km\\crt","/d_AMD64_","/fo{objpath}\\version.res","/n",".\\src\\booting\\windrv\\version.rc"]
		},
		"detour":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\windows\\detour.c"}
		},
		"hooks":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\windows\\hooks.c"}
		},
		"layered":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\windows\\layered.c"}
		},
		"nvsys":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\windows\\nvsys.c"}
		},
		"winhvm":
		{
			"cmd":["cl"],
			"var":{"src":".\\src\\xpf_core\\windows\\winhvm.c"}
		},
		"msrhook":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\windows\\msrhook.asm"}
		},
		"svm_hv":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\svm_hv.asm"}
		},
		"vt_hv":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\vt_hv.asm"}
		},
		"interrupt":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\interrupt.asm"}
		},
		"kpcr":
		{
			"cmd":["ml64"],
			"var":{"src":".\\src\\xpf_core\\msvc\\kpcr.asm"}
		},
		"msvcrt":
		{
			"cmd":["python","build_msvcrt.py","--outdir","{outdir}"]
		},
		"NoirVisor":
		{
			"cmd":["link","{objpath}\\driver.obj","{objpath}\\version.res","{objpath}\\detour.obj","{objpath}\\hooks.obj","{objpath}\\layered.obj","{objpath}\\nvsys.obj","{objpath}\\winhvm.obj","{objpath}\\msrhook.obj","{objpath}\\svm_hv.obj","{objpath}\\vt_hv.obj","{objpath}\\interrupt.obj","{objpath}\\kpcr.obj","{objpath}\\memcpy.obj","{objpath}\\memset.obj","{objpath}\\memcmp.obj","{objpath}\\strlen.obj","{objpath}\\cpu_disp.obj",".\\target\\x86_64-pc-windows-msvc\\{cargo_preset}\\nvcore.lib","/OUT:.\\bin\\{outdir}\\NoirVisor.sys","/SUBSYSTEM:NATIVE","/ENTRY:NoirDriverEntry","/PDB:.\\bin\\{outdir}\\NoirVisor.pdb"],
			"dependencies":["cargo","driver","version","detour","hooks","layered","nvsys","winhvm","msrhook","svm_hv","vt_hv","interrupt","kpcr","msvcrt"]
		},
		"sign":
		{
			"cmd":["signtool","sign","/v","/fd","SHA1","/f",".\\build\\ztnxtest.pfx",".\\bin\\{outdir}\\NoirVisor.sys"],
			"dependencies":["NoirVisor"]
		}
	},
	"common_flags":
	{
		"cl":["{src}","/nologo","/I{incpath}\\km\\crt","/I{incpath}\\shared","/I{incpath}\\km","/Zi","/W3","/WX","/D_KERNEL_MODE","/D_AMD64_","/D_M_AMD64","/D_WIN64","/D_UNICODE","/DUNICODE","/D_{instruction}","/Zc:wchar_t","/std:c17","/FAcs","/Fa{objpath}\\{instruction}.cod","/Fo{objpath}\\{instruction}.obj","/Fd{objpath}","/FS","/GS-","/Qspectre","/Gr","/Gy","/TC","/c","/errorReport:queue"],
		"ml64":["/W3","/WX","/Zf","/Zd","/Zi","/I.\\src\\xpf_core\\msvc","/D_amd64","/D_msvc","/Fo{objpath}\\{instruction}.obj","/c","/nologo","{src}"],
		"link":["/NODEFAULTLIB","/LIBPATH:{libpath}\\km\\x64","ntoskrnl.lib","/NOLOGO","/DEBUG","/Machine:X64","/ERRORREPORT:QUEUE"]
	},
	"opt_flags":
	{
		"cl":["/O2","/Gy"],
		"link":["/OPT:REF","/OPT:ICF"],
		"cargo":["--release"]
	},
	"extra_env":
	{
		"cflags":"/GS-"
	},
	"internal_var":
	{
		"outdir_dev":"compchk_win7x64",
		"outdir_rel":"compfre_win7x64"
	}
}